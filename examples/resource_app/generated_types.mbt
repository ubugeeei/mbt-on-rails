///|
fn mbor_hex_digit(value : Int) -> Char {
  if value < 10 {
    ('0'.to_int() + value).to_char().unwrap()
  } else {
    ('A'.to_int() + value - 10).to_char().unwrap()
  }
}

///|
fn mbor_is_unreserved_route_char(ch : Char) -> Bool {
  let code = ch.to_int()
  (code >= 'a'.to_int() && code <= 'z'.to_int()) ||
  (code >= 'A'.to_int() && code <= 'Z'.to_int()) ||
  (code >= '0'.to_int() && code <= '9'.to_int()) ||
  ch == '-' ||
  ch == '.' ||
  ch == '_' ||
  ch == '~'
}

